# ---------------- Model selection (pick ONE block) ----------------
# 1) Hosted Anthropic  (pip install -e ".[anthropic]")
# ANTHROPIC_API_KEY=sk-ant-...
# ML_HARNESS_MODEL=anthropic:claude-sonnet-5-5

# 2) Ollama, local  (pip install -e ".[ollama]";  ollama pull qwen3:14b)
ML_HARNESS_MODEL=ollama:qwen3:14b
# ML_HARNESS_MODEL_BASE_URL=http://localhost:11434
ML_HARNESS_MODEL_NUM_CTX=32768

# 3) vLLM / LM Studio / llama.cpp / LocalAI  (pip install -e ".[openai]")
# ML_HARNESS_MODEL_PROVIDER=vllm            # or lmstudio | llamacpp | openai_compatible
# ML_HARNESS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# ML_HARNESS_MODEL_BASE_URL=http://localhost:8000/v1   # LM Studio :1234/v1, llama.cpp :8080/v1
# ML_HARNESS_MODEL_API_KEY=                 # usually not needed locally

ML_HARNESS_MODEL_TEMPERATURE=0
ML_HARNESS_MODEL_TIMEOUT_S=600

# ---------------- Sandbox / guard ----------------
ML_HARNESS_SANDBOX_IMAGE=ml-harness-sandbox:latest
ML_HARNESS_TIMEOUT_S=600
ML_HARNESS_SANDBOX_MEMORY=4g
ML_HARNESS_SANDBOX_CPUS=2
ML_HARNESS_LEAKAGE_MODE=block   # block | warn | off
